# ==============================================
# PetCam Django 백엔드 환경변수
# ==============================================
# 사용법: 이 파일을 .env로 복사 후 값 입력
#   cp .env.example .env
# 주의: .env는 Git에 커밋하지 마세요.
# ==============================================

# ============ 필수 (프로덕션) ============

# Django 시크릿 키 (32자 이상, 프로덕션 필수)
# 생성: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-this

# 허용 호스트 (콤마 구분, 프로덕션에서 설정)
# 예: ALLOWED_HOSTS=petcam.com,api.petcam.com
ALLOWED_HOSTS=

# ============ 데이터베이스 (Step 8에서 사용) ============

# PostgreSQL 연결 URL
# 로컬: postgresql://user:password@localhost:5432/dbname
# Docker: postgresql://user:password@db:5432/dbname
DATABASE_URL=postgresql://petuser:your-password@localhost:5432/petdb

# ============ 선택 ============

# 디버그 모드 (true/false)
DEBUG=true

# JWT Access 토큰 만료 (분)
ACCESS_TOKEN_EXPIRE_MINUTES=30
